# 项目所在目录（存放 goblog 代码，Nginx 配置，SSH 证书，日志/数据的目录）
ROOT_DIR: /root/narasux

# ========== MySQL 配置 ==========
# MySQL Root 密码
MYSQL_ROOT_PASSWORD: root-pwd
# MySQL 初始化数据库名
MYSQL_DATABASE: goblog-web
# MySQL 访问用户名
MYSQL_USER: goblog
# MySQL 访问用户密码
MYSQL_PASSWORD: goblog-pwd

# ========== GitHub OAuth 配置 ==========
# GitHub OAuth App Client ID（在 GitHub Settings -> Developer settings -> OAuth Apps 创建）
GITHUB_CLIENT_ID: your-github-client-id
# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET: your-github-client-secret
# GitHub OAuth 回调地址（需要与 GitHub OAuth App 配置一致）
GITHUB_CALLBACK_URL: https://www.narasux.cn/auth/github/callback

# ========== Session 配置 ==========
# Session 加密密钥（建议使用随机字符串）
SESSION_SECRET: your-session-secret-key
# Session 最大有效期（秒），默认 1 天
SESSION_MAX_AGE: 86400

# ========== 交互功能开关 ==========
# 是否启用交互功能（GitHub 登录与评论，true/1 开启，默认关闭）
INTERACTION_ENABLED: false
